# ── LLM provider ─────────────────────────────────────────────
# openai | anthropic | ollama | openrouter
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Model routing ────────────────────────────────────────────
# MODEL_CHAT:  composition / narrative (70B quality at ~$0.10/M)
# MODEL_FAST:  routing / classification / judges (8B at ~$0.05/M)
# MODEL_EMBED: embeddings for the RAG vector store (OpenRouter serves none;
#              dense retrieval falls back to local BM25 until wired separately)
MODEL_CHAT=meta-llama/llama-3.3-70b-instruct
MODEL_FAST=meta-llama/llama-3.1-8b-instruct
MODEL_EMBED=text-embedding-3-small

# ── LangSmith observability ──────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# ── Storage ──────────────────────────────────────────────────
# Qdrant vector DB (docker compose) and the SQLite game DB
QDRANT_URL=http://localhost:6333
DATABASE_URL=sqlite:///data/endless-dungeon.db

# ── Auth (MVP: low-privilege dev token) ──────────────────────
DEV_TOKEN=dev-secret-change-me

# ── Hardening / safety ───────────────────────────────────────
# ENABLE_SIGNING:  per-session HMAC frame signing (default ON in tests)
# ENABLE_MODERATION: optional content moderation hook (provider API / Llama Guard)
# GENERATION_TIMEOUT: seconds before a hung generation is force-terminated
ENABLE_SIGNING=true
ENABLE_MODERATION=false
GENERATION_TIMEOUT=30
